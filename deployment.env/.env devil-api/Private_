touch .env
# The URL where your devil-api backend is running
PRIVATE_DEVIL_API_URL="http://127.0.0.1:8000"

# The authorization key required by devil-api
PRIVATE_DEVIL_API_KEY="your_secure_api_key_here"

# Optional: Set to "true" if you are developing locally without SSL/HTTPS
ALLOW_INSECURE_BACKEND="true"
# Inside your devil-api .env file
CORS_ORIGINS="http://localhost:5173,https://your-frontend-domain.com"
uvicorn main:app --reload --port 8000
npm run dev -- --open
npm install pm2 -g
pm2 start node --name "devil-frontend" -- build/index.js
pm2 start "venv/bin/uvicorn main:app --port 8000" --name "devil-backend"
pm2 save
pm2 startup
sudo apt install certbot python3-certbot-nginx
sudo certbot --nginx -d yourdomain.com -d www.yourdomain.com
